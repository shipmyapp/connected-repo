{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"ignoreDependencies": ["@orpc/server"],
	// Kept code that nothing in the template calls yet. Ignored per file and issue type, never deleted.
	"ignoreIssues": {
		// Offline-first stack (decision: offline-first stays): the online-first adapter, local DB
		// lifecycle, sync triggers, media proxy readiness and stored row types are its public API.
		"apps/frontend/src/worker/db/online-first.adapter.ts": ["exports", "types"],
		"apps/frontend/src/worker/db/db.lifecycle.ts": ["exports"],
		"apps/frontend/src/worker/db/db.manager.ts": ["types"],
		"apps/frontend/src/utils/sync-triggers.ts": ["exports"],
		"apps/frontend/src/worker/worker.context.ts": ["exports"],
		// Silent-sync push cron (offline-first): its stop function is part of the cron's lifecycle.
		"apps/backend/src/cron_jobs/silent_sync_dispatch.cron.ts": ["exports"],
		// Types named in other modules' emitted declarations (tsc fails with TS4023 if they are
		// not exported): the active-team procedure context, the worker APIs, the install state.
		"apps/backend/src/procedures/protected.procedure.ts": ["types"],
		// The session-security result, named in rpcSensitiveProcedure's context.
		"apps/backend/src/middlewares/session-security.middleware.ts": ["types"],
		"apps/frontend/src/worker/sync/sync.orchestrator.ts": ["types"],
		"apps/frontend/src/worker/db/files.db.ts": ["types"],
		"apps/frontend/src/worker/cdn/media-upload.service.ts": ["types"],
		"apps/frontend/src/hooks/usePwaInstall.ts": ["types"],
		// Client types of the super-admin RPC router, for a console that consumes it.
		"apps/backend/src/routers/super_admin/super_admin.router.ts": ["types"],
		// captureSentryMessage: Sentry helper for apps to report handled conditions.
		"apps/frontend/src/instrumentation.ts": ["exports"]
	},
	"rules": {
		"exports": "error",
		"files": "error"
	},
	"workspaces": {
		"apps/backend": {
			"ignoreFiles": [
				"src/db/migrations/**"
			],
			"project": ["src/**/*.ts"]
		},
		"apps/frontend": {
			"entry": [
				"index.html",
				// Service worker, built by vite-plugin-pwa (injectManifest, srcDir src/sw; vite.config.ts).
				"src/sw/sw.ts",
				// Module workers, started with new Worker(new URL(...)) in src/worker/worker.proxy.ts.
				"src/worker/data.worker.ts",
				"src/worker/media.worker.ts",
				// Ambient JSX typing for the <pwa-install> element (PwaInstallHost.tsx); tsc loads it through tsconfig.app.json "include".
				"src/types/pwa-install.d.ts"
			],
			"project": ["src/**/*.{ts,tsx}"]
		},
		"packages/typescript-config": {
			"entry": ["*.json"],
			"project": ["*.json"]
		},
		"packages/ui-mui": {
			"entry": ["src/**/*.ts"],
			"project": ["src/**/*.{ts,tsx}"]
		},
		"packages/zod-schemas": {
			"entry": ["src/**/*.ts"],
			"project": ["src/**/*.ts"]
		}
	}
}
