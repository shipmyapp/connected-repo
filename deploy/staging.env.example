# connected-repo STAGING. Paste this whole file, filled in, into ONE of:
#   • Compose mode: the Dokploy Compose app's Environment tab (written to
#     `.env` beside docker-compose.prod.yml);
#   • Application mode: Dokploy → the project → the production environment →
#     Environment Variables (shared variables, referenced by deploy/dokploy/*).
# Fill in every <…>. A blank value means "not set". Never commit a filled copy.
#
# One file, several readers: the backend reads all of it at runtime; the SPAs
# take their VITE_* keys as BUILD args (a change needs a redeploy, not a
# restart); the frontend nginx reads CSP_*, MCP_PUBLIC_URL and the Sentry DSN.

# ── Stack (Compose mode) ─────────────────────────────────────────────────
# Unique on the server: names the Traefik routers and the network aliases.
STACK_NAME=connected-repo-staging
NODE_ENV=staging
APP_HOST=staging.example.com
# The console's host. Its first label must be one of RESERVED_TENANT_SLUGS
# (packages/zod-schemas/src/tenant.utils.ts: sa, admin, superadmin, …), or it
# would be read as a team's host.
SUPERADMIN_HOST=sa-staging.example.com
# Bundled services; drop a name to use an external one (DB_HOST / REDIS_URL).
COMPOSE_PROFILES=postgres,redis
# HTTP-challenge resolver for APP_HOST and SUPERADMIN_HOST (Dokploy's default).
TLS_CERT_RESOLVER=letsencrypt
# DNS-challenge resolver for *.TENANT_ROOT_DOMAIN, added to Dokploy's Traefik.
TLS_WILDCARD_CERT_RESOLVER=letsencrypt-dns

# ── Hosts ────────────────────────────────────────────────────────────────
# Better Auth's base URL and Google's callback host: the app host.
WEBAPP_URL=https://staging.example.com
VITE_API_URL=https://staging.example.com
# Origins allowed to call the API with cookies (team hosts are accepted by suffix).
ALLOWED_ORIGINS=https://staging.example.com,https://sa-staging.example.com
# Session cookie readable on the app, console and team hosts.
PROD_COOKIE_DOMAIN=.example.com
# Proxies in front of the backend that set X-Forwarded-For: 1 in both deploy
# modes (Traefik → nginx → backend). Change it only if you put another proxy
# in front (a CDN: see deploy/README.md).
TRUSTED_PROXY_COUNT=1

# ── Team hosts ───────────────────────────────────────────────────────────
# <slug>.<root> serves a team's own branded app. Also drives the compose
# tenant router and the frontend's VITE_TENANT_ROOT_DOMAIN build arg.
TENANT_ROOT_DOMAIN=staging.example.com
# staging. and sa-staging. share only `.example.com` with production, so the
# session cookie lives next to production's. A prefix of its own is REQUIRED,
# or staging and production overwrite each other's sign-in. Changing it on a
# live environment signs everyone out.
AUTH_COOKIE_PREFIX=connected-repo-staging

# ── Application MCP ──────────────────────────────────────────────────────
# Blank: AI apps connect to https://<app host>/mcp. Set to
# https://mcp.<TENANT_ROOT_DOMAIN> to give the MCP a host of its own: the
# wildcard route and certificate already cover it, and the frontend nginx
# passes it to the backend (deploy/README.md).
MCP_PUBLIC_URL=

# ── Database ─────────────────────────────────────────────────────────────
# Bundled (COMPOSE_PROFILES has postgres): DB_HOST=<STACK_NAME>-postgres,
# DB_PORT=5432, DB_SSL=disable. A Postgres that Dokploy runs: its internal
# service name, DB_SSL=disable. A managed cluster: its host and port,
# DB_SSL=verify-full with its CA.
DB_HOST=connected-repo-staging-postgres
DB_PORT=5432
DB_USER=connected_repo
DB_PASSWORD=<openssl rand -hex 24>
DB_NAME=connected_repo_staging
DB_SSL=disable
# PEM on one line, `\n` for the line breaks.
DB_SSL_CA=
# Keep DB_POOL_SIZE + PG_TBUS_CONCURRENCY under the server's connection limit.
DB_POOL_SIZE=10
PG_TBUS_CONCURRENCY=3

# ── Redis (required) ─────────────────────────────────────────────────────
# Bundled: redis://<STACK_NAME>-redis:6379. Else the Dokploy-run or managed URL.
REDIS_URL=redis://connected-repo-staging-redis:6379

# ── Auth ─────────────────────────────────────────────────────────────────
# `openssl rand -base64 48`. Never reuse production's.
BETTER_AUTH_SECRET=<at-least-32-characters>
# Authorised redirect URI: https://staging.example.com/api/auth/callback/google
GOOGLE_WEB_CLIENT_ID=<id>.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=<secret>
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# One line in double quotes, `\n` for the line breaks.
APPLE_PRIVATE_KEY=
APPLE_APP_BUNDLE_ID=
SUPER_ADMIN_EMAILS=<you@example.com>
SUPER_ADMIN_PHONE_NUMBERS=

# ── Object storage ───────────────────────────────────────────────────────
# Objects are served by public URL; never list the bucket, and never put its
# public host under TENANT_ROOT_DOMAIN or PROD_COOKIE_DOMAIN (deploy/README.md).
S3_ENDPOINT=<https://s3.region.provider.com>
S3_REGION=<region>
S3_ACCESS_KEY_ID=<key>
S3_SECRET_ACCESS_KEY=<secret>
S3_BUCKET_NAME=connected-repo-staging
S3_PUBLIC_URL=

# ── Push and notifications (backend) ─────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=
NOVU_SECRET_KEY=
NOVU_API_URL=

# ── Observability (backend) ──────────────────────────────────────────────
# Names the pg-tbus queues too: never change it once live.
OTEL_SERVICE_NAME=connected-repo-backend
LOG_LEVEL=
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
# Blank: <OTEL_SERVICE_NAME>@<commit>, one release per deploy.
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_PROFILES_SAMPLE_RATE=

# ── Frontend nginx (runtime) ─────────────────────────────────────────────
# Extra connect-src origins for the CSP, space-separated: the S3 endpoint or
# bucket host (presigned uploads), a CDN, a self-hosted Novu.
CSP_CONNECT_EXTRA=
# true enforces the full CSP; blank keeps it report-only (restart to apply).
CSP_ENFORCE=

# ── Frontend build args (baked into the bundle) ──────────────────────────
VITE_OTEL_SERVICE_NAME=connected-repo-frontend
# Where the published terms and privacy notice live (from docs/legal). Both
# blank: no links and no agreement step.
VITE_TERMS_URL=<https://example.com/terms>
VITE_PRIVACY_URL=<https://example.com/privacy>
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=staging
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=
# Build secret for the source-map upload; blank = no upload.
VITE_SENTRY_AUTH_TOKEN=
# Sampling; blank keeps the code's defaults.
VITE_SENTRY_TRACES_SAMPLE_RATE=
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=
VITE_NOVU_APP_IDENTIFIER=
VITE_NOVU_API_URL=
VITE_NOVU_SOCKET_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
