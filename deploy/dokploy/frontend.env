# Dokploy → frontend application → Environment → Environment Settings (runtime;
# a change needs a restart, not a rebuild). BACKEND_UPSTREAM is the backend
# application's App Name (shown under its name in Dokploy, e.g.
# connected-repo-backend-a1b2c3) and port. Swarm gives that name a stable
# virtual IP, so nginx resolves it once at start.

BACKEND_UPSTREAM=<backend-app-name>:3000
# The Sentry tunnel and the CSP's report-uri.
SENTRY_DSN=${{environment.VITE_SENTRY_DSN}}
CSP_CONNECT_EXTRA=${{environment.CSP_CONNECT_EXTRA}}
CSP_ENFORCE=${{environment.CSP_ENFORCE}}
# The application MCP's own host, when set: nginx passes that host to the backend.
MCP_PUBLIC_URL=${{environment.MCP_PUBLIC_URL}}
