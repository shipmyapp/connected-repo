# Dokploy → backend application → Environment → Environment Settings.
# Values live once, in the Dokploy environment's shared variables (paste the
# filled-in deploy/prod.env.example there); these lines only reference them.
# PORT (3000), HOST (0.0.0.0) and the graceful-shutdown timeouts come from the
# image.

NODE_ENV=${{environment.NODE_ENV}}
WEBAPP_URL=${{environment.WEBAPP_URL}}
VITE_API_URL=${{environment.VITE_API_URL}}
ALLOWED_ORIGINS=${{environment.ALLOWED_ORIGINS}}
PROD_COOKIE_DOMAIN=${{environment.PROD_COOKIE_DOMAIN}}
TRUSTED_PROXY_COUNT=${{environment.TRUSTED_PROXY_COUNT}}
TENANT_ROOT_DOMAIN=${{environment.TENANT_ROOT_DOMAIN}}
AUTH_COOKIE_PREFIX=${{environment.AUTH_COOKIE_PREFIX}}
MCP_PUBLIC_URL=${{environment.MCP_PUBLIC_URL}}

DB_HOST=${{environment.DB_HOST}}
DB_PORT=${{environment.DB_PORT}}
DB_USER=${{environment.DB_USER}}
DB_PASSWORD=${{environment.DB_PASSWORD}}
DB_NAME=${{environment.DB_NAME}}
DB_SSL=${{environment.DB_SSL}}
DB_SSL_CA=${{environment.DB_SSL_CA}}
DB_POOL_SIZE=${{environment.DB_POOL_SIZE}}
PG_TBUS_CONCURRENCY=${{environment.PG_TBUS_CONCURRENCY}}
REDIS_URL=${{environment.REDIS_URL}}

BETTER_AUTH_SECRET=${{environment.BETTER_AUTH_SECRET}}
GOOGLE_WEB_CLIENT_ID=${{environment.GOOGLE_WEB_CLIENT_ID}}
GOOGLE_WEB_CLIENT_SECRET=${{environment.GOOGLE_WEB_CLIENT_SECRET}}
GOOGLE_IOS_CLIENT_ID=${{environment.GOOGLE_IOS_CLIENT_ID}}
GOOGLE_ANDROID_CLIENT_ID=${{environment.GOOGLE_ANDROID_CLIENT_ID}}
APPLE_CLIENT_ID=${{environment.APPLE_CLIENT_ID}}
APPLE_TEAM_ID=${{environment.APPLE_TEAM_ID}}
APPLE_KEY_ID=${{environment.APPLE_KEY_ID}}
APPLE_PRIVATE_KEY=${{environment.APPLE_PRIVATE_KEY}}
APPLE_APP_BUNDLE_ID=${{environment.APPLE_APP_BUNDLE_ID}}
SUPER_ADMIN_EMAILS=${{environment.SUPER_ADMIN_EMAILS}}
SUPER_ADMIN_PHONE_NUMBERS=${{environment.SUPER_ADMIN_PHONE_NUMBERS}}

S3_ENDPOINT=${{environment.S3_ENDPOINT}}
S3_REGION=${{environment.S3_REGION}}
S3_ACCESS_KEY_ID=${{environment.S3_ACCESS_KEY_ID}}
S3_SECRET_ACCESS_KEY=${{environment.S3_SECRET_ACCESS_KEY}}
S3_BUCKET_NAME=${{environment.S3_BUCKET_NAME}}
S3_PUBLIC_URL=${{environment.S3_PUBLIC_URL}}

FIREBASE_SERVICE_ACCOUNT_JSON=${{environment.FIREBASE_SERVICE_ACCOUNT_JSON}}
NOVU_SECRET_KEY=${{environment.NOVU_SECRET_KEY}}
NOVU_API_URL=${{environment.NOVU_API_URL}}

# Names traces, log lines AND the pg-tbus queues (src/events/tbus.ts): never
# change it on a live environment, or queued tasks are orphaned.
OTEL_SERVICE_NAME=${{environment.OTEL_SERVICE_NAME}}
LOG_LEVEL=${{environment.LOG_LEVEL}}
SENTRY_DSN=${{environment.SENTRY_DSN}}
SENTRY_ENVIRONMENT=${{environment.SENTRY_ENVIRONMENT}}
SENTRY_RELEASE=${{environment.SENTRY_RELEASE}}
SENTRY_TRACES_SAMPLE_RATE=${{environment.SENTRY_TRACES_SAMPLE_RATE}}
SENTRY_PROFILES_SAMPLE_RATE=${{environment.SENTRY_PROFILES_SAMPLE_RATE}}
