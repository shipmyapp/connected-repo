# Dependencies
node_modules
.yarn
.pnp.*

# Build outputs
dist
build
.next
.turbo

# Development files
# NOTE: .git is intentionally NOT ignored — the frontend Dockerfile reads the
# short commit SHA from it to name each deploy's Sentry release. It only lives
# in the build stages; no final image contains it.
.gitignore
*.md
!README.md
CONTRIBUTING.md
DEVELOPMENT_PLAN.md

# IDE
.vscode
.idea
*.swp
*.swo
*~
.opencode

# Tests
coverage
.vitest
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
e2e
playwright-report

# Environment files, at any depth. Dokploy writes an application's
# Environment Settings to a .env beside its Dockerfile (apps/backend/.env);
# that file holds every production secret and must never reach an image.
**/.env
**/.env.*
!**/.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Misc
tmp
temp
*.tmp

# Frontend files
netlify.toml
