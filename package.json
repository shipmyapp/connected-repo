{
	"author": "Balkrishna Agarwal <krishna@shipmyapp.in>",
	"dependencies": {
		"@orpc/server": "^1.16.2",
		"ulid": "^3.0.2",
		"zod": "^4.6.7"
	},
	"description": "Starter Monorepo using Turbo of Nodejs + OrchidORM + oRPC + Reactjs with opentelemetry setup",
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"concurrently": "^10.0.7",
		"knip": "^6.45.1",
		"tsc-alias": "^1.9.10",
		"turbo": "^2.11.11",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=26"
	},
	"license": "AGPL-3.0-only",
	"name": "connected-repo",
	"packageManager": "yarn@1.22.22",
	"private": true,
	"repository": "git@github.com:shipmyapp/connected-repo.git",
	"scripts": {
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"check:deploy": "node scripts/check-deploy-config.mjs",
		"clean": "turbo run clean && rm -rf node_modules && rm -rf .yarn/cache && yarn cache clean",
		"db": "turbo db --",
		"dev": "turbo run dev",
		"format": "biome format . --write",
		"knip": "knip",
		"lint": "turbo run lint",
		"prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\"",
		"test": "turbo run test",
		"test:build": "turbo run test:build",
		"test:coverage": "turbo run test:coverage",
		"test:db:setup": "turbo run test:db:setup",
		"test:e2e:no-build": "turbo run test:e2e:no-build",
		"test:e2e:with-build": "turbo run test:e2e:with-build",
		"test:e2e:ui:no-build": "turbo run test:e2e:ui:no-build",
		"test:e2e:ui:with-build": "turbo run test:e2e:ui:with-build",
		"test:run": "turbo run test:run",
		"test:ui": "turbo run test:ui"
	},
	"version": "1.1.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
