# Local development only. In production the console calls /api/* on its own
# origin, which its nginx proxies to the backend.

# Leave EMPTY to call the same origin (the Vite dev proxy below forwards /api/*).
# Set only to point the client at an absolute backend URL.
VITE_API_URL=

# Host-mode dev only: where the Vite proxy forwards /api/*. Defaults to
# http://localhost:3000, where `yarn dev` runs the backend.
VITE_DEV_BACKEND_PROXY_TARGET=
