	"name": "@connected-repo/frontend",
	"private": true,
	"repository": "git@github.com:shipmyapp/connected-repo.git",
	"scripts": {
		"build": "tsc -b && vite build",
		"build:debug": "tsc -b tsconfig.app.json && vite build --debug",
		"check-types": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
		"clean": "rm -rf node_modules && rm -rf dist",
		"dev": "vite",
		"format": "biome format . --write",
		"generate:icons": "node scripts/generate-icons.mjs",
		"install:shots": "node scripts/install-shots.mjs",
		"lint": "biome check .",
		"preview": "cross-env VITE_USER_APP_URL=http://localhost:4173 bash -c 'if [[ \"$*\" == *\"--no-build\"* ]]; then vite preview; else yarn run build && vite preview; fi' --",
		"test": "vitest",
		"test:run": "vitest run",
		"test:build": "tsc -b && cross-env VITE_USER_NODE_ENV=test vite build --mode test",
		"test:e2e:no-build": "playwright test",
		"test:e2e:with-build": "playwright test",
		"test:e2e:ui:no-build": "playwright test --ui",
		"test:e2e:ui:with-build": "playwright test --ui"
	},
	"type": "module",
	"version": "0.1.0"
}
