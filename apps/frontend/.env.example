# connected-repo frontend: every key the app reads (validated by
# src/utils/env_validator.zod.utils.ts at build time). A blank value means
# "not set". In Docker builds the VITE_* keys come in as build args
# (apps/frontend/Dockerfile); they are baked into the bundle, so they are public.

# Becomes VITE_USER_NODE_ENV (Vite).
NODE_ENV=development

# Leave EMPTY to mimic production (same origin): the SPA calls /api/* on its
# own origin and either the Vite dev-server proxy (host-mode `yarn dev`) or the
# nginx sidecar (`docker compose -f docker-compose.dev.yml up`) forwards it to
# the backend. Set only to hit an absolute backend URL.
VITE_API_URL=
# The shared app's origin, for the "go to the shared app" link on team hosts.
# Empty = window.location.origin (OAuth callbacks stay on the visible host).
VITE_USER_APP_URL=

# Root domain of team hosts; must equal the backend's TENANT_ROOT_DOMAIN.
# Empty = off. Dev: localhost, then open http://<slug>.localhost:5173.
VITE_TENANT_ROOT_DOMAIN=

# Host-mode dev only: where the Vite proxy forwards /api/*, /mcp and the OAuth
# /.well-known/* documents. Defaults to http://localhost:3000, where `yarn dev`
# runs the backend.
VITE_DEV_BACKEND_PROXY_TARGET=

# Test credentials (only used when NODE_ENV=test).
VITE_TEST_PASSWORD=SecureTestPassword123!@#

# Names the Sentry release (<this>@<commit>) and traces. Keep it stable.
VITE_OTEL_SERVICE_NAME=connected-repo-frontend

# Sentry. Blank DSN = off (a placeholder DSN would turn Sentry on in dev). The
# DSN also feeds nginx's tunnel and CSP reports in production.
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=development
# Set only by the Docker build (the commit, from .build-sha); blank locally,
# where the release is the package version.
VITE_SENTRY_RELEASE=
# Sampling (0–1). Empty keeps the code's defaults: traces 0.3, session
# replays 0, replays on error 1.
VITE_SENTRY_TRACES_SAMPLE_RATE=
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=
# Source-map upload, Docker production builds only (the token is a build secret).
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=
VITE_SENTRY_AUTH_TOKEN=

# Novu in-app inbox (bell). Blank app identifier = the bell is hidden. Same
# Novu environment and region as the backend.
VITE_NOVU_APP_IDENTIFIER=
VITE_NOVU_API_URL=
VITE_NOVU_SOCKET_URL=

# Firebase web config for FCM push. Blank = push off.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Public Terms and Privacy pages (both blank = no links and no agreement step).
# docs/legal/ holds skeletons a project completes and publishes.
VITE_TERMS_URL=
VITE_PRIVACY_URL=
