{
	"author": "Balkrishna Agarwal <krishna@shipmyapp.in>",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1000.0",
		"@aws-sdk/s3-request-presigner": "^3.1000.0",
		"@better-auth/core": "1.5.0",
		"@better-auth/oauth-provider": "1.5.0",
		"@connected-repo/zod-schemas": "*",
		"@modelcontextprotocol/sdk": "1.32.2",
		"@novu/api": "^1.7.0",
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/core": "^2.5.1",
		"@opentelemetry/exporter-trace-otlp-http": "^0.212.0",
		"@opentelemetry/instrumentation-http": "^0.212.0",
		"@opentelemetry/instrumentation-pg": "^0.64.0",
		"@opentelemetry/resources": "^2.5.1",
		"@opentelemetry/sdk-node": "^0.212.0",
		"@opentelemetry/sdk-trace-node": "^2.5.1",
		"@orpc/experimental-pino": "^1.14.6",
		"@orpc/openapi": "^1.14.6",
		"@orpc/otel": "^1.14.6",
		"@orpc/server": "^1.14.6",
		"@orpc/standard-server-node": "1.14.6",
		"@orpc/zod": "^1.14.6",
		"@sentry/node": "^10.78.0",
		"@sentry/opentelemetry": "^10.78.0",
		"@sentry/profiling-node": "^10.78.0",
		"axios": "^1.13.6",
		"better-auth": "1.5.0",
		"dotenv": "^17.3.1",
		"firebase-admin": "^13.0.2",
		"ioredis": "^5.11.1",
		"jose": "^6.2.2",
		"node-cron": "^4.5.0",
		"orchid-orm": "^1.73.1",
		"pg": "^8.19.0",
		"pg-tbus": "^1.0.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"pqb": "0.68.1",
		"ua-parser-js": "^2.0.9",
		"ulid": "^3.0.2"
	},
	"description": "Starter Monorepo using Turbo of Nodejs + OrchidORM + oRPC + Reactjs with opentelemetry setup",
	"devDependencies": {
		"@connected-repo/typescript-config": "*",
		"@orpc/contract": "1.14.6",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"@vitest/coverage-v8": "^4.0.18",
		"@vitest/ui": "^4.0.18",
		"cross-env": "^10.1.0",
		"tsc-alias": "^1.9.10",
		"tsx": "^4.23.15",
		"typescript": "5.9.3",
		"vitest": "^4.0.18"
	},
	"license": "AGPL-3.0-only",
	"main": "src/server.ts",
	"name": "@connected-repo/backend",
	"private": true,
	"repository": "git@github.com:shipmyapp/connected-repo.git",
	"scripts": {
		"build": "tsx src/scripts/novu_check_templates.ts && tsc && tsc-alias",
		"check-types": "tsc --noEmit",
		"clean": "rm -rf node_modules && rm -rf dist",
		"db": "tsx src/db/db_script.ts",
		"gen:openapi": "tsx src/scripts/generate_openapi.ts",
		"auth:encrypt-tokens": "tsx src/scripts/encrypt_oauth_tokens.ts",
		"check:openapi": "cross-env NODE_ENV=test tsx src/scripts/generate_openapi.ts && git diff --exit-code -- openapi_pretty.json",
		"novu:check": "tsx src/scripts/novu_check_templates.ts",
		"novu:pull": "tsx src/scripts/novu_pull_workflows.ts",
		"novu:status": "tsx src/scripts/novu_status.ts",
		"dev": "tsx watch --clear-screen=false src/server.ts",
		"dev:inspect": "tsx watch --inspect src/server.ts",
		"format": "biome format . --write",
		"lint": "biome check .",
		"start": "node dist/server.js",
		"test": "cross-env NODE_ENV=test IS_E2E_TEST=false vitest",
		"test:build": "cross-env NODE_ENV=test IS_E2E_TEST=true yarn run build",
		"test:coverage": "cross-env NODE_ENV=test IS_E2E_TEST=false vitest run --coverage",
		"test:db:setup": "cross-env NODE_ENV=test yarn db drop && cross-env NODE_ENV=test yarn db create && cross-env NODE_ENV=test yarn db up && cross-env NODE_ENV=test yarn db seed",
		"test:run": "cross-env NODE_ENV=test IS_E2E_TEST=false vitest run",
		"test:server:start": "cross-env NODE_ENV=test IS_E2E_TEST=true yarn run start",
		"test:ui": "cross-env NODE_ENV=test vitest --ui"
	},
	"version": "1.1.0"
}
