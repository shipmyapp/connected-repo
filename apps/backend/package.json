{
	"author": "Balkrishna Agarwal <krishna@shipmyapp.in>",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1169.0",
		"@aws-sdk/s3-request-presigner": "^3.1169.0",
		"@better-auth/core": "1.7.25",
		"@better-auth/oauth-provider": "1.7.25",
		"@connected-repo/zod-schemas": "*",
		"@modelcontextprotocol/sdk": "1.32.2",
		"@novu/api": "^3.19.1",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/instrumentation": "^0.223.2",
		"@orpc/experimental-pino": "^1.16.2",
		"@orpc/openapi": "^1.16.2",
		"@orpc/otel": "^1.16.2",
		"@orpc/server": "^1.16.2",
		"@orpc/standard-server-node": "1.16.2",
		"@orpc/zod": "^1.16.2",
		"@sentry/node": "^11.12.0",
		"@sentry/profiling-node": "^11.12.0",
		"axios": "^1.21.1",
		"better-auth": "1.7.25",
		"dotenv": "^18.0.10",
		"firebase-admin": "^14.5.1",
		"ioredis": "^6.0.0",
		"jose": "^6.2.17",
		"node-cron": "^4.6.0",
		"orchid-orm": "^1.78.51",
		"pg": "^8.23.1",
		"pg-tbus": "^1.0.0",
		"pino": "^10.4.0",
		"pino-pretty": "^13.2.0",
		"pqb": "0.73.40",
		"ua-parser-js": "^2.0.10",
		"ulid": "^3.0.2"
	},
	"description": "Starter Monorepo using Turbo of Nodejs + OrchidORM + oRPC + Reactjs with Sentry tracing",
	"devDependencies": {
		"@connected-repo/typescript-config": "*",
		"@orpc/contract": "1.16.2",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"@vitest/coverage-v8": "^5.1.0",
		"@vitest/ui": "^5.1.0",
		"cross-env": "^10.1.0",
		"tsc-alias": "^1.9.10",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	},
	"license": "AGPL-3.0-only",
	"main": "src/server.ts",
	"name": "@connected-repo/backend",
	"private": true,
	"repository": "git@github.com:shipmyapp/connected-repo.git",
	"scripts": {
		"build": "tsx src/scripts/novu_check_templates.ts && tsc && tsc-alias",
		"check-types": "tsc --noEmit",
		"clean": "rm -rf node_modules && rm -rf dist",
		"db": "tsx src/db/db_script.ts",
		"gen:openapi": "tsx src/scripts/generate_openapi.ts",
		"auth:encrypt-tokens": "tsx src/scripts/encrypt_oauth_tokens.ts",
		"check:openapi": "cross-env NODE_ENV=test tsx src/scripts/generate_openapi.ts && git diff --exit-code -- openapi_pretty.json",
		"novu:check": "tsx src/scripts/novu_check_templates.ts",
		"novu:pull": "tsx src/scripts/novu_pull_workflows.ts",
		"novu:status": "tsx src/scripts/novu_status.ts",
		"dev": "tsx watch --clear-screen=false src/server.ts",
		"dev:inspect": "tsx watch --inspect src/server.ts",
		"format": "biome format . --write",
		"lint": "biome check .",
		"start": "node dist/server.js",
		"test": "cross-env NODE_ENV=test IS_E2E_TEST=false vitest",
		"test:build": "cross-env NODE_ENV=test IS_E2E_TEST=true yarn run build",
		"test:coverage": "cross-env NODE_ENV=test IS_E2E_TEST=false vitest run --coverage",
		"test:db:setup": "cross-env NODE_ENV=test yarn db drop && cross-env NODE_ENV=test yarn db create && cross-env NODE_ENV=test yarn db up && cross-env NODE_ENV=test yarn db seed",
		"test:run": "cross-env NODE_ENV=test IS_E2E_TEST=false vitest run",
		"test:server:start": "cross-env NODE_ENV=test IS_E2E_TEST=true yarn run start",
		"test:ui": "cross-env NODE_ENV=test vitest --ui"
	},
	"version": "2.0.0"
}
