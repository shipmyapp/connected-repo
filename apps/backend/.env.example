# connected-repo backend: every variable the backend reads, validated at boot
# by src/configs/env.config.ts (a missing required one fails fast). A blank
# value means "not set": the variable takes its default. The Docker build
# smoke-tests the image against this file, so every value here must pass the
# schema. Production values: deploy/prod.env.example.

# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Bind host. Defaults to 127.0.0.1 in tests, 0.0.0.0 elsewhere.
HOST=
# Pino log level. Defaults to "debug" in dev, "info" otherwise.
LOG_LEVEL=
# Development only: pretty single-line logs; false prints raw pino JSON.
LOG_PRETTY=
# Graceful shutdown, in ms: HTTP drain (default 30000), then in-flight
# pg-tbus tasks (default 300000). The image sets both.
GRACEFUL_SHUTDOWN_TIMEOUT=
AGENT_TASK_TIMEOUT=
# Names traces, log lines AND the pg-tbus queues: never change it on a live
# environment, or queued tasks are orphaned.
OTEL_SERVICE_NAME=connected-repo-backend

# ── URLs and origins ─────────────────────────────────────────────────────
# Host-mode dev: the Vite dev server on :5173 proxies /api/* to this backend,
# so both point at :5173. docker-compose.dev.yml overrides both to the nginx
# sidecar on :8080. Production: https://<app host>.
WEBAPP_URL=http://localhost:5173
VITE_API_URL=http://localhost:5173
# CORS and Better Auth trusted origins, comma-separated (the console's too).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5175
# Production: `.<root>`, so the session cookie set on the app host (where the
# Google callback lands) is readable on the console and team hosts.
PROD_COOKIE_DOMAIN=
# Proxies in front of the backend that set X-Forwarded-For. 0 in host-mode
# dev (no proxy: the socket address is the client); 1 behind nginx or Traefik
# (every deployed mode, and the dev compose stack).
TRUSTED_PROXY_COUNT=0

# ── Team hosts ───────────────────────────────────────────────────────────
# `<slug>.<root>` is one team's private PWA. Blank = off. Dev: `localhost`
# (Chrome resolves team1.localhost; a team's host is trusted once a team holds
# that slug). Production: the root domain, with PROD_COOKIE_DOMAIN=.<root>.
# Serve nothing but this app under the root: the bucket's public host
# (S3_PUBLIC_URL), marketing, docs and status pages go on another domain,
# because every subdomain receives the session cookie.
TENANT_ROOT_DOMAIN=
# Better Auth's cookie name prefix. Only when two stacks share one cookie
# domain (staging next to production). Changing it signs everyone out.
AUTH_COOKIE_PREFIX=

# ── Application MCP (connected AI apps) ──────────────────────────────────
# Blank: /mcp is served on VITE_API_URL's origin. Set to a host of its own
# (e.g. https://mcp.example.com): /mcp then lives there only.
# See docs/runbooks/connected-apps.md and deploy/README.md.
MCP_PUBLIC_URL=

# ── Database ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=connected_repo_orpc_db
# TLS to Postgres: disable (same Docker network) | require | verify-full.
# verify-full wants the provider's CA certificate in DB_SSL_CA (PEM; a
# one-line value may use literal \n for newlines).
DB_SSL=disable
DB_SSL_CA=
DB_POOL_SIZE=25
# pg-tbus worker concurrency. Keep DB_POOL_SIZE + this under the server's limit.
PG_TBUS_CONCURRENCY=3

# ── Redis 7 (required) ───────────────────────────────────────────────────
# `docker compose -f docker-compose.dev.yml up postgres redis` runs one on
# 127.0.0.1:6379. Holds rate-limit buckets and short-lived state; never the
# source of truth.
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────────────────
# `openssl rand -base64 48`. The example value is refused at a production or
# staging boot.
BETTER_AUTH_SECRET=32-characters-or-more-better-auth-secret=
# Google OAuth web client. Redirect URI: <VITE_API_URL>/api/auth/callback/google
GOOGLE_WEB_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=GOCSPX-your-google-client-secret
# Mobile app ID tokens (bearer sign-in). Blank = not accepted.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# Sign in with Apple. All blank = Apple sign-in off.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM in double quotes with \n line breaks.
APPLE_PRIVATE_KEY=
APPLE_APP_BUNDLE_ID=

# ── Super-admin console ──────────────────────────────────────────────────
# Comma-separated emails or phone numbers granted access.
SUPER_ADMIN_EMAILS=
SUPER_ADMIN_PHONE_NUMBERS=

# ── Object storage (S3-compatible; uploads through presigned URLs) ───────
# Required. The placeholders pass the schema so a fresh checkout boots;
# uploads need a real bucket.
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=connected-repo-dev
# Public base URL of the bucket or CDN, when it differs from the endpoint.
# Never under TENANT_ROOT_DOMAIN (the backend refuses to start).
S3_PUBLIC_URL=

# ── Push (firebase-admin, silent sync) ───────────────────────────────────
# Service-account JSON on one line. Blank (and no GOOGLE_APPLICATION_CREDENTIALS
# file path) = server-side push off.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# ── Notifications (Novu). Blank NOVU_SECRET_KEY = notifications off. ─────
# With a key, every boot brings Novu's workflows in line with src/novu
# (newer side wins). The email and FCM providers are configured in Novu.
NOVU_SECRET_KEY=
# Self-hosted Novu API, or https://eu.api.novu.co. Defaults to Novu Cloud (US).
NOVU_API_URL=

# ── Sentry. Blank SENTRY_DSN = off. ──────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Blank: <OTEL_SERVICE_NAME>@<commit> in an image, else the package version.
SENTRY_RELEASE=
# Defaults: 0.1 in production, 1.0 elsewhere for traces; 0 for profiles.
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_PROFILES_SAMPLE_RATE=
