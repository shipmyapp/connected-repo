# Node Environment
NODE_ENV=test
PORT=3001

# Allowed Origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:3001

# Team hosts: `<slug>.localhost` is a team host once a team holds the slug.
TENANT_ROOT_DOMAIN=localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=connected_repo_orpc_db_test

# Redis (the CI service; locally
# `docker compose -f docker-compose.dev.yml up -d redis`). Database 1 so
# test buckets never mix with the dev server's (database 0). Without a
# running Redis the suite still passes: limits fail open and the tests that
# need a live Redis skip (outside CI).
REDIS_URL=redis://localhost:6379/1

# Google OAuth2 (using dummy values for test)
GOOGLE_WEB_CLIENT_ID=test-google-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=GOCSPX-test-google-client-secret

# API URLs
WEBAPP_URL=http://localhost:5174
VITE_API_URL=http://localhost:3001

# Better Auth Secret
BETTER_AUTH_SECRET=32-characters-or-more-better-auth-secret=for-test

# OpenTelemetry Configuration
OTEL_SERVICE_NAME=connected-repo-backend

# Object storage (dummy values; nothing in the suite reaches S3)
S3_ENDPOINT=https://blr1.digitaloceanspaces.com
S3_REGION=blr1
S3_ACCESS_KEY_ID=test-key-id
S3_SECRET_ACCESS_KEY=test-secret-key
S3_BUCKET_NAME=test-bucket
S3_PUBLIC_URL=https://test-bucket.blr1.cdn.digitaloceanspaces.com
